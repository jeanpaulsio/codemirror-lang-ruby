// Ruby grammar for Lezer
//
// This is a starter grammar covering core Ruby constructs.
// It will be extended incrementally -- see CLAUDE.md for the full roadmap.
//
// References:
//   - tree-sitter-ruby: https://github.com/tree-sitter/tree-sitter-ruby
//   - Ruby syntax docs: https://docs.ruby-lang.org/en/master/syntax_rdoc.html
//   - Lezer grammar guide: https://lezer.codemirror.net/docs/guide/

@top Program { statement* }

@skip { whitespace | LineComment | BlockComment }

statement {
  ExpressionStatement { expression !exprEnd semi? } |
  MethodDef |
  ClassDef |
  ModuleDef |
  IfStatement |
  UnlessStatement |
  WhileStatement |
  UntilStatement |
  ForStatement |
  CaseStatement |
  BeginBlock |
  ReturnStatement |
  YieldStatement |
  RaiseStatement |
  Assignment |
  MultipleAssignment |
  BareMethodCall
}

// Bare method calls without parens for common Ruby methods.
// Uses a curated keyword list to avoid ambiguity with local variables.
BareMethodCall {
  (bareMethod<"puts"> | bareMethod<"print"> | bareMethod<"p"> |
   bareMethod<"warn"> | bareMethod<"fail"> |
   bareMethod<"require"> | bareMethod<"require_relative"> |
   bareMethod<"load"> | bareMethod<"autoload"> |
   bareMethod<"include"> | bareMethod<"extend"> | bareMethod<"prepend"> |
   bareMethod<"attr_reader"> | bareMethod<"attr_writer"> | bareMethod<"attr_accessor"> |
   bareMethod<"public"> | bareMethod<"private"> | bareMethod<"protected"> |
   bareMethod<"module_function"> |
   bareMethod<"alias"> | bareMethod<"alias_method"> |
   bareMethod<"using"> |
   bareMethod<"throw"> | bareMethod<"catch">)
  commaSep1<expression> semi?
}

// Method definitions:
// 1. Regular: def foo(args) ... end
// 2. No parens: def foo ... end
// 3. Endless: def foo(args) = expr (Ruby 3.0+)
// 4. Setter: def name=(val) ... end
// 5. self.method: def self.foo(args) ... end
MethodDef {
  kw<"def"> Identifier ParamList semi? MethodBody kw<"end"> |
  kw<"def"> Identifier semi MethodBody kw<"end"> |
  kw<"def"> Identifier ParamList "=" expression semi? |
  kw<"def"> Identifier "=" ParamList semi? MethodBody kw<"end"> |
  kw<"def"> kw<"self"> "." Identifier ParamList semi? MethodBody kw<"end"> |
  kw<"def"> kw<"self"> "." Identifier semi MethodBody kw<"end">
}

MethodBody { statement* }

ParamList {
  "(" commaSep<Param> ")"
}

Param {
  SplatParam |
  DoubleSplatParam |
  BlockParam |
  DefaultParam |
  Identifier
}

SplatParam { "*" Identifier }
DoubleSplatParam { "**" Identifier }
BlockParam { "&" Identifier }
DefaultParam { Identifier "=" expression }

ClassDef {
  kw<"class"> Constant (inheritsOp Constant)? semi? ClassBody kw<"end">
}

ClassBody { statement* }

ModuleDef {
  kw<"module"> Constant semi? ModuleBody kw<"end">
}

ModuleBody { statement* }

IfStatement {
  kw<"if"> expression semi? statement* ElsifClause* ElseClause? kw<"end">
}

ElsifClause {
  kw<"elsif"> expression semi? statement*
}

ElseClause {
  kw<"else"> semi? statement*
}

UnlessStatement {
  kw<"unless"> expression semi? statement* ElseClause? kw<"end">
}

WhileStatement {
  kw<"while"> expression semi? statement* kw<"end">
}

UntilStatement {
  kw<"until"> expression semi? statement* kw<"end">
}

ForStatement {
  kw<"for"> Identifier kw<"in"> expression semi? statement* kw<"end">
}

CaseStatement {
  kw<"case"> expression? semi? (WhenClause* | InClause*) ElseClause? kw<"end">
}

WhenClause {
  kw<"when"> commaSep1<expression> semi? statement*
}

// Pattern matching (Ruby 3.0+)
// Patterns reuse expression since they highlight identically. The pin operator
// (^variable) is the only pattern-specific construct.
// Guard clauses (in pattern if condition) are deferred — the if/unless
// keyword conflicts with IfStatement/UnlessStatement in the LR parser.
InClause {
  kw<"in"> (PinExpression | expression) semi? statement*
}

// Pin operator — scoped to InClause only, since ^ is bitwise XOR elsewhere
PinExpression { "^" expression }

BeginBlock {
  kw<"begin"> semi? statement* RescueClause* ElseClause? EnsureClause? kw<"end">
}

RescueClause {
  kw<"rescue"> ExceptionList? semi? statement*
}

ExceptionList {
  Constant ~rescue ("," Constant)* ("=>" Identifier)?
}

EnsureClause {
  kw<"ensure"> semi? statement*
}

ReturnStatement { kw<"return"> expression? semi }
YieldStatement { kw<"yield"> expression? semi }
RaiseStatement { kw<"raise"> expression? semi }

Assignment {
  (Identifier | InstanceVariable | ClassVariable | GlobalVariable | Constant)
  AssignOp expression semi? |
  SubscriptExpression AssignOp expression semi?
}

// Multiple assignment: a, b = 1, 2 or a, *b = [1, 2, 3]
MultipleAssignment {
  AssignmentTarget ("," AssignmentTarget)+ "=" expression ("," expression)* semi?
}

AssignmentTarget {
  "*" Identifier |
  Identifier | InstanceVariable | ClassVariable | GlobalVariable | Constant ~rescue
}

expression {
  Identifier |
  InstanceVariable |
  ClassVariable |
  GlobalVariable |
  Constant ~rescue |
  Integer |
  Float |
  SingleQuotedString |
  InterpolatedString |
  CharacterLiteral |
  PercentStringLiteral |
  Regex |
  Heredoc |
  Symbol |
  Array |
  Hash |
  kw<"nil"> |
  kw<"true"> |
  kw<"false"> |
  kw<"self"> |
  MethodCall |
  BinaryExpression |
  UnaryExpression |
  ParenExpression |
  Lambda |
  Range |
  TernaryExpression |
  ConditionalModifier |
  ScopeResolution |
  SubscriptExpression |
  Block |
  DoBlock |
  BlockCall
}

// BlockCall: any expression followed by a Block or DoBlock.
// items.each { |x| x }, foo.bar(1) do |x| x end
// Uses !blockCall precedence to beat ExpressionStatement's !exprEnd reduce.
BlockCall { expression !blockCall (Block | DoBlock) }

// MethodCall requires either a receiver (expr.method) or args (method(args)).
// A bare identifier without receiver or args is just an Identifier, not a MethodCall.
// Supports regular dot (.), safe navigation (&.), and scope resolution (::).
MethodCall {
  expression !member "." Identifier ArgList? |
  expression !member "&." Identifier ArgList? |
  Identifier !call ArgList
}

// Scope resolution: Foo::Bar, Foo::Bar::Baz, self::method
ScopeResolution {
  expression !member "::" (Constant | Identifier)
}

// Subscript access: arr[0], hash[:key], matrix[i][j]
SubscriptExpression {
  expression !member "[" commaSep<expression> "]"
}

ArgList {
  "(" commaSep<Arg> ")"
}

Arg {
  SplatArg { "*" expression } |
  DoubleSplatArg { "**" expression } |
  BlockArg { "&" expression } |
  expression
}

BinaryExpression {
  expression !add ArithOp expression |
  expression !add "-" expression |
  expression !mul moduloOp expression |
  expression !mul divideOp expression |
  expression !mul "*" expression |
  expression !exp "**" expression |
  expression !compare CompareOp expression |
  expression !compare lessThanOp expression |
  expression !compare lessThanEqOp expression |
  expression !logic LogicOp expression |
  expression !logic kw<"and"> expression |
  expression !logic kw<"or"> expression
}

UnaryExpression {
  ("!" | kw<"not"> | "-") !unary expression
}

ParenExpression { "(" expression ")" }

Block {
  ~blockOrHash "{" BlockParams? statement* "}" ~blockOrHash
}

DoBlock {
  kw<"do"> BlockParams? semi? statement* kw<"end">
}

BlockParams {
  "|" commaSep<Identifier> "|"
}

Lambda {
  "->" ParamList? (Block | DoBlock)
}

Range {
  expression !range (".." | "...") expression
}

TernaryExpression {
  expression !ternary "?" expression colonOp expression
}

ConditionalModifier {
  expression !modifier (kw<"if"> | kw<"unless"> | kw<"while"> | kw<"until">) expression
}

// Double-quoted strings with #{} interpolation.
// Uses @local tokens so the tokenizer switches to string-content mode inside "...".
// InterpolationEnd is a grammar rule (not local token) so brace balancing works
// naturally for nested expressions like "#{foo({a: 1})}".
@skip {} {
  InterpolatedString[isolate] {
    '"' (Interpolation | StringEscape | StringContent)* stringEnd
  }
}

Interpolation {
  InterpolationStart expression InterpolationEnd
}

InterpolationEnd[openedBy=InterpolationStart] { "}" }

@local tokens {
  InterpolationStart[closedBy=InterpolationEnd] { "#{" }
  stringEnd { '"' }
  StringEscape { "\\" _ }
  @else StringContent
}

// Heredocs are matched as a single opaque token by the external tokenizer.
// The tokenizer reads <<[-~]?DELIM, scans to the closing DELIM line, and
// emits the entire heredoc as one Heredoc token. Interpolation inside
// heredocs is not yet supported (would need @local tokens + ContextTracker).

Array { "[" commaSep<expression> "]" }
Hash { ~blockOrHash "{" (HashPair ("," HashPair)*)? "}" ~blockOrHash }
HashPair { expression "=>" expression | Identifier colonOp expression }

@precedence {
  member @left,
  call @right,
  unary,
  exp @right,
  mul @left,
  add @left,
  range @right,
  compare @left,
  logic @left,
  ternary @right,
  modifier @right,
  blockCall @right,
  exprEnd
}

commaSep<expr> { (expr ("," expr)*)? }
commaSep1<expr> { expr ("," expr)* }

kw<term> { @specialize[@name={term}]<Identifier, term> }
bareMethod<term> { @extend[@name={term}]<Identifier, term> }

semi { ";" | newline }

@tokens {
  whitespace { $[ \t]+ }
  newline { $[\n\r] }

  LineComment { "#" ![\n\r]* }
  BlockComment { "=begin" ![]*  "=end" }

  Identifier { $[a-z_] $[a-zA-Z0-9_]* ("?" | "!")? }
  InstanceVariable { "@" $[a-zA-Z_] $[a-zA-Z0-9_]* }
  ClassVariable { "@@" $[a-zA-Z_] $[a-zA-Z0-9_]* }
  GlobalVariable { "$" $[a-zA-Z0-9_]+ }
  Constant { $[A-Z] $[a-zA-Z0-9_]* }

  Integer { $[0-9]+ ("_" $[0-9]+)* }
  Float { $[0-9]+ ("_" $[0-9]+)* "." $[0-9]+ ("_" $[0-9]+)* }

  SingleQuotedString {
    "'" (![\\'] | "\\" _)* "'"
  }

  // Symbol is now handled by external tokenizer to avoid overlap with ":"
  // in hash shorthand context. See symbolTokenizer in tokens.ts.
  CharacterLiteral { "?" ("\\" _ | ![$ \t\n\r]) }

  // %-literals are now handled by the external tokenizer to support
  // all delimiters (not just brackets) and proper content scanning.
  // "/" is NOT in ArithOp — it's handled by the external tokenizer which
  // emits either Regex or divideOp depending on context.
  // "%" is NOT in ArithOp — handled by external tokenizer which emits
  // either PercentStringLiteral or moduloOp depending on context.
  ArithOp { "+" }
  // "<" and "<=" are NOT in CompareOp — they're handled by the external
  // tokenizer which also emits heredocStart for <<DELIM.
  CompareOp { "==" | "!=" | ">" | ">=" | "<=>" | "===" }
  AssignOp { "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "||=" | "&&=" | "<<=" | ">>=" }
  LogicOp { "&&" | "||" }

  // ":" is NOT in punctuation — handled by symbolTokenizer which emits
  // either Symbol (:foo) or colonOp (for ternary : and hash shorthand key:)
  "(" ")" "[" "]" "{" "}" "." "&." "::" "," ";" "|" "?" "^" ".." "..." "=>" "->" "&" "*" "**"

  @precedence {
    BlockComment,
    LineComment,
    Float,
    Integer,
    InstanceVariable,
    ClassVariable,
    GlobalVariable,
    Constant,
    Identifier,
    CharacterLiteral,
    CompareOp,
    "::",
    "=>",
    "->",
    ArithOp,
    AssignOp,
    "...",
    "..",
    "&.",
    ".",
    "**",
    "*",
    "&"
  }
}

// External tokenizers for context-dependent tokens
// External tokenizers for context-dependent tokens
@external tokens regexTokenizer from "./tokens" { Regex, divideOp[@name=ArithOp] }
@external tokens percentLiteralTokenizer from "./tokens" { PercentStringLiteral, moduloOp[@name=ArithOp] }
@external tokens symbolTokenizer from "./tokens" { Symbol, colonOp }
@external tokens lessThanTokenizer from "./tokens" {
  Heredoc,
  lessThanOp[@name=CompareOp],
  lessThanEqOp[@name=CompareOp],
  inheritsOp
}

@detectDelim
