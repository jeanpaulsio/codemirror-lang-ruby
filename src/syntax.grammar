// Ruby grammar for Lezer
//
// This is a starter grammar covering core Ruby constructs.
// It will be extended incrementally -- see CLAUDE.md for the full roadmap.
//
// References:
//   - tree-sitter-ruby: https://github.com/tree-sitter/tree-sitter-ruby
//   - Ruby syntax docs: https://docs.ruby-lang.org/en/master/syntax_rdoc.html
//   - Lezer grammar guide: https://lezer.codemirror.net/docs/guide/

@top Program { statement* }

// Newlines and semicolons are whitespace — the grammar uses structural
// delimiters (keywords, braces, parens) to determine statement boundaries.
@skip { whitespace | semicolonSkip | LineComment | BlockComment }

statement {
  ExpressionStatement { expression !exprEnd } |
  MethodDef |
  ClassDef |
  ModuleDef |
  IfStatement ~stmtOrExpr |
  UnlessStatement ~stmtOrExpr |
  WhileStatement |
  UntilStatement |
  ForStatement |
  CaseStatement ~stmtOrExpr |
  BeginBlock ~stmtOrExpr |
  Assignment |
  MultipleAssignment |
  BareMethodCall
}

// Bare method calls without parens for common Ruby methods.
// Uses a curated keyword list to avoid ambiguity with local variables.
BareMethodCall {
  (bareMethod<"puts"> | bareMethod<"print"> | bareMethod<"p"> |
   bareMethod<"warn"> | bareMethod<"fail"> |
   bareMethod<"require"> | bareMethod<"require_relative"> |
   bareMethod<"load"> | bareMethod<"autoload"> |
   bareMethod<"include"> | bareMethod<"extend"> | bareMethod<"prepend"> |
   bareMethod<"attr_reader"> | bareMethod<"attr_writer"> | bareMethod<"attr_accessor"> |
   bareMethod<"public"> | bareMethod<"private"> | bareMethod<"protected"> |
   bareMethod<"module_function"> |
   bareMethod<"alias"> | bareMethod<"alias_method"> |
   bareMethod<"using"> |
   bareMethod<"throw"> | bareMethod<"catch"> |
   bareMethod<"gem"> | bareMethod<"source"> | bareMethod<"group"> |
   bareMethod<"validates"> | bareMethod<"validate"> |
   bareMethod<"has_many"> | bareMethod<"has_one"> | bareMethod<"belongs_to"> |
   bareMethod<"before_action"> | bareMethod<"after_action"> | bareMethod<"around_action"> |
   bareMethod<"before_create"> | bareMethod<"before_save"> | bareMethod<"after_create"> | bareMethod<"after_save"> |
   bareMethod<"render"> | bareMethod<"redirect_to"> |
   bareMethod<"delegate"> | bareMethod<"scope"> | bareMethod<"enum"> |
   bareMethod<"task"> | bareMethod<"desc"> | bareMethod<"namespace"> |
   bareMethod<"raise">)
  commaSep1<Arg>
}

// Method definitions:
// 1. Regular: def foo(args) ... end
// 2. No parens: def foo ... end
// 3. Endless: def foo(args) = expr (Ruby 3.0+)
// 4. Setter: def name=(val) ... end
// 5. self.method: def self.foo(args) ... end
// 6. Operator: def <=>(other) ... end, def [](i) ... end
MethodDef {
  kw<"def"> Identifier ~defBody ParamList MethodBody kw<"end"> |
  kw<"def"> Identifier ~defBody MethodBody kw<"end"> |
  kw<"def"> Identifier ParamList "=" expression |
  kw<"def"> Identifier "=" ParamList MethodBody kw<"end"> |
  kw<"def"> kw<"self"> "." Identifier ~defBody ParamList MethodBody kw<"end"> |
  kw<"def"> kw<"self"> "." Identifier ~defBody MethodBody kw<"end"> |
  kw<"def"> kw<"self"> "." Identifier ParamList "=" expression |
  kw<"def"> OperatorMethodName ParamList MethodBody kw<"end"> |
  kw<"def"> kw<"self"> "." OperatorMethodName ParamList MethodBody kw<"end">
}

// Operator method names: <=>, ==, +, -, *, /, %, **, [], []=, <<, >>, etc.
OperatorMethodName {
  CompareOp | greaterThanOp | greaterThanEqOp | lessThanOp | lessThanEqOp |
  ArithOp | "-" | "*" | "**" | "&" | "|" | "^" | "~" |
  shiftLeftOp | shiftRightOp |
  "[]" | "[]="
}

MethodBody { statement* }

ParamList {
  "(" commaSep<Param> ")"
}

Param {
  SplatParam |
  DoubleSplatParam |
  BlockParam |
  KeywordParam |
  DefaultParam |
  Identifier ~paramOrExpr
}

SplatParam { "*" Identifier }
DoubleSplatParam { "**" Identifier }
BlockParam { "&" Identifier ~paramOrExpr }
// KeywordParam: name: (required keyword) or name: default (keyword with default)
KeywordParam { Identifier colonOp expression? }
DefaultParam { Identifier "=" expression }

ClassDef {
  kw<"class"> className (inheritsOp className)? ClassBody kw<"end">
}

ClassBody { statement* }

ModuleDef {
  kw<"module"> className ModuleBody kw<"end">
}

// Scoped class/module names: Foo, Foo::Bar, ::TopLevel::Foo
className { Constant ~rescue ("::" Constant)* }

ModuleBody { statement* }

IfStatement {
  kw<"if"> expression statement* ElsifClause* ElseClause? kw<"end">
}

ElsifClause {
  kw<"elsif"> expression statement*
}

ElseClause {
  kw<"else"> statement*
}

UnlessStatement {
  kw<"unless"> expression statement* ElseClause? kw<"end">
}

WhileStatement {
  kw<"while"> expression !loopBody doKw? statement* kw<"end">
}

UntilStatement {
  kw<"until"> expression !loopBody doKw? statement* kw<"end">
}

ForStatement {
  kw<"for"> Identifier kw<"in"> expression !loopBody doKw? statement* kw<"end">
}

CaseStatement {
  kw<"case"> expression? (WhenClause* | InClause*) ElseClause? kw<"end">
}

WhenClause {
  kw<"when"> commaSep1<expression> statement*
}

// Pattern matching (Ruby 3.0+)
// Patterns reuse expression since they highlight identically. The pin operator
// (^variable) is the only pattern-specific construct.
// Guard clauses (in pattern if condition) are deferred — the if/unless
// keyword conflicts with IfStatement/UnlessStatement in the LR parser.
InClause {
  kw<"in"> (PinExpression | expression) statement*
}

// Pin operator — scoped to InClause only, since ^ is bitwise XOR elsewhere
PinExpression { "^" expression }

BeginBlock {
  kw<"begin"> statement* RescueClause* ElseClause? EnsureClause? kw<"end">
}

RescueClause {
  kw<"rescue"> ExceptionList? statement*
}

// ExceptionList: rescue StandardError => e, rescue => e (bare), rescue StandardError, RuntimeError => e
ExceptionList {
  Constant ~rescue ("," Constant)* ("=>" Identifier)? |
  "=>" Identifier
}

EnsureClause {
  kw<"ensure"> statement*
}

Assignment {
  (Identifier | InstanceVariable | ClassVariable | GlobalVariable | Constant)
  AssignOp expression |
  SubscriptExpression AssignOp expression
}

// Multiple assignment: a, b = 1, 2 or a, *b = [1, 2, 3]
MultipleAssignment {
  AssignmentTarget ("," AssignmentTarget)+ "=" expression ("," expression)*
}

AssignmentTarget {
  "*" Identifier |
  Identifier | InstanceVariable | ClassVariable | GlobalVariable | Constant ~rescue
}

expression {
  Identifier ~paramOrExpr |
  InstanceVariable |
  ClassVariable |
  GlobalVariable |
  Constant ~rescue |
  Integer |
  Float |
  SingleQuotedString |
  InterpolatedString |
  CharacterLiteral |
  PercentStringLiteral |
  Regex |
  Heredoc |
  Symbol |
  Array |
  Hash |
  kw<"nil"> |
  kw<"true"> |
  kw<"false"> |
  kw<"self"> |
  kw<"return"> |
  kw<"yield"> |
  kw<"super"> |
  IfStatement ~stmtOrExpr |
  UnlessStatement ~stmtOrExpr |
  CaseStatement ~stmtOrExpr |
  BeginBlock ~stmtOrExpr |
  MethodCall |
  BinaryExpression |
  UnaryExpression |
  ParenExpression |
  Lambda |
  Range |
  TernaryExpression |
  ConditionalModifier |
  ScopeResolution |
  SubscriptExpression |
  Block |
  DoBlock |
  BlockCall
}

// BlockCall: any expression followed by a Block or DoBlock.
// items.each { |x| x }, foo.bar(1) do |x| x end
// Uses !blockCall precedence to beat ExpressionStatement's !exprEnd reduce.
BlockCall { expression !blockCall (Block | DoBlock) }

// MethodCall requires either a receiver (expr.method) or args (method(args)).
// A bare identifier without receiver or args is just an Identifier, not a MethodCall.
// Supports regular dot (.), safe navigation (&.), and scope resolution (::).
// MethodCall requires either a receiver (expr.method) or args (method(args)).
// Supports regular dot (.), safe navigation (&.), and scope resolution (::).
// NOTE: For receiver-style calls (expr.method(args)), the LR parser treats
// `(args)` as a separate ParenExpression. This is visually identical for
// highlighting. Unary `&` in UnaryExpression handles `obj.method(&block)`.
MethodCall {
  expression !member "." Identifier ArgList? |
  expression !member "&." Identifier ArgList? |
  Identifier !call ArgList
}

// Scope resolution: Foo::Bar, Foo::Bar::Baz, self::method
ScopeResolution {
  expression !member "::" (Constant | Identifier)
}

// Subscript access: arr[0], hash[:key], matrix[i][j]
SubscriptExpression {
  expression !member "[" commaSep<expression> "]"
}

ArgList {
  "(" commaSep<Arg> ")"
}

Arg {
  SplatArg { "*" expression } |
  DoubleSplatArg { "**" expression } |
  BlockArg { "&" expression } |
  KeywordArg { Identifier colonOp expression } |
  expression
}

BinaryExpression {
  expression !add ArithOp expression |
  expression !add "-" expression |
  expression !mul moduloOp expression |
  expression !mul divideOp expression |
  expression !mul "*" expression |
  expression !exp "**" expression |
  expression !shift shiftLeftOp expression |
  expression !shift shiftRightOp expression |
  expression !bitand "&" expression |
  expression !bitor "|" expression |
  expression !bitor "^" expression |
  expression !compare CompareOp expression |
  expression !compare lessThanOp expression |
  expression !compare lessThanEqOp expression |
  expression !compare greaterThanOp expression |
  expression !compare greaterThanEqOp expression |
  expression !logic LogicOp expression |
  expression !logic kw<"and"> expression |
  expression !logic kw<"or"> expression
}

UnaryExpression {
  ("!" | kw<"not"> | "-" | ArithOp | "~") !unary expression
}

// ParenExpression allows comma-separated expressions and `&expr` for block-pass
// in receiver-style calls where the LR parser treats `obj.method(args)` as
// MethodCall + ParenExpression.
ParenExpression { "(" (BlockPassExpression | expression ("," expression)* ","?) ")" }
BlockPassExpression { "&" expression }

Block {
  ~blockOrHash "{" BlockParams? statement* "}" ~blockOrHash
}

DoBlock {
  doKw BlockParams? statement* kw<"end">
}

// "do" uses @extend (not @specialize via kw<>) so that both the Identifier base
// token and the doKw extended token are available to the parser. This allows the
// parser to see doKw actions in WhileStatement/UntilStatement contexts (loop
// separator) alongside DoBlock contexts (block start).
doKw[@name=do] { @extend<Identifier, "do"> }

BlockParams {
  "|" commaSep<Identifier> "|"
}

Lambda {
  "->" ParamList (Block | DoBlock)
}

Range {
  expression !range (".." | "...") expression
}

TernaryExpression {
  expression !ternary "?" expression colonOp expression
}

ConditionalModifier {
  expression !modifier (kw<"if"> | kw<"unless"> | kw<"while"> | kw<"until">) expression
}

// Double-quoted strings with #{} interpolation.
// Uses @local tokens so the tokenizer switches to string-content mode inside "...".
// InterpolationEnd is a grammar rule (not local token) so brace balancing works
// naturally for nested expressions like "#{foo({a: 1})}".
@skip {} {
  InterpolatedString[isolate] {
    '"' (Interpolation | StringEscape | StringContent)* stringEnd
  }
}

Interpolation {
  InterpolationStart expression InterpolationEnd
}

InterpolationEnd[openedBy=InterpolationStart] { "}" }

@local tokens {
  InterpolationStart[closedBy=InterpolationEnd] { "#{" }
  stringEnd { '"' }
  StringEscape { "\\" _ }
  @else StringContent
}

// Heredocs are matched as a single opaque token by the external tokenizer.
// The tokenizer reads <<[-~]?DELIM, scans to the closing DELIM line, and
// emits the entire heredoc as one Heredoc token. Interpolation inside
// heredocs is not yet supported (would need @local tokens + ContextTracker).

Array { "[" commaSep<expression> "]" }
Hash { ~blockOrHash "{" (HashPair ("," HashPair)* ","?)? "}" ~blockOrHash }
HashPair { expression "=>" expression | Identifier colonOp expression }

@precedence {
  member @left,
  call @right,
  unary,
  exp @right,
  mul @left,
  add @left,
  shift @left,
  bitand @left,
  bitor @left,
  range @right,
  compare @left,
  logic @left,
  ternary @right,
  modifier @right,
  loopBody @right,
  blockCall @right,
  exprEnd
}

// Trailing comma only in commaSep (delimited by ] ) }) — not in commaSep1
// (used by BareMethodCall where there's no closing delimiter).
commaSep<expr> { (expr ("," expr)* ","?)? }
commaSep1<expr> { expr ("," expr)* }

kw<term> { @specialize[@name={term}]<Identifier, term> }
bareMethod<term> { @extend[@name={term}]<Identifier, term> }

@tokens {
  whitespace { $[ \t\n\r]+ }
  semicolonSkip { ";" }

  LineComment { "#" ![\n\r]* }
  BlockComment { "=begin" ![]*  "=end" }

  Identifier { $[a-z_] $[a-zA-Z0-9_]* ("?" | "!")? }
  InstanceVariable { "@" $[a-zA-Z_] $[a-zA-Z0-9_]* }
  ClassVariable { "@@" $[a-zA-Z_] $[a-zA-Z0-9_]* }
  // Includes special globals like $!, $~, $&, $;, $,, $0, $LOAD_PATH
  GlobalVariable { "$" ($[a-zA-Z0-9_]+ | $[!~&`;,./\\?<>*$@:]) }
  Constant { $[A-Z] $[a-zA-Z0-9_]* }

  Integer { $[0-9]+ ("_" $[0-9]+)* }
  Float { $[0-9]+ ("_" $[0-9]+)* "." $[0-9]+ ("_" $[0-9]+)* }

  SingleQuotedString {
    "'" (![\\'] | "\\" _)* "'"
  }

  // Symbol is now handled by external tokenizer to avoid overlap with ":"
  // in hash shorthand context. See symbolTokenizer in tokens.ts.
  CharacterLiteral { "?" ("\\" _ | ![$ \t\n\r]) }

  // %-literals are now handled by the external tokenizer to support
  // all delimiters (not just brackets) and proper content scanning.
  // "/" is NOT in ArithOp — it's handled by the external tokenizer which
  // emits either Regex or divideOp depending on context.
  // "%" is NOT in ArithOp — handled by external tokenizer which emits
  // either PercentStringLiteral or moduloOp depending on context.
  ArithOp { "+" }
  // "<" and "<=" are NOT in CompareOp — they're handled by the external
  // tokenizer which also emits heredocStart for <<DELIM.
  // ">" and ">=" are NOT in CompareOp — handled by greaterThanTokenizer
  // which also emits ">>" (shift) and ">>=" (assignment).
  CompareOp { "==" | "!=" | "<=>" | "===" | "=~" | "!~" }
  AssignOp { "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "**=" | "||=" | "&&=" | "<<=" | ">>=" | "|=" | "&=" | "^=" }
  LogicOp { "&&" | "||" }

  // ":" is NOT in punctuation — handled by symbolTokenizer which emits
  // either Symbol (:foo) or colonOp (for ternary : and hash shorthand key:)
  "(" ")" "[" "]" "{" "}" "." "&." "::" "," "|" "?" "^" ".." "..." "=>" "->" "&" "*" "**" "~" "[]" "[]="

  @precedence {
    BlockComment,
    LineComment,
    Float,
    Integer,
    InstanceVariable,
    ClassVariable,
    GlobalVariable,
    Constant,
    Identifier,
    CharacterLiteral,
    CompareOp,
    "::",
    "=>",
    "->",
    AssignOp,
    ArithOp,
    "~",
    "[]=",
    "[]",
    "...",
    "..",
    "&.",
    ".",
    "**",
    "*",
    "&"
  }
}

// External tokenizers for context-dependent tokens
@external tokens regexTokenizer from "./tokens" { Regex, divideOp[@name=ArithOp] }
@external tokens percentLiteralTokenizer from "./tokens" { PercentStringLiteral, moduloOp[@name=ArithOp] }
@external tokens symbolTokenizer from "./tokens" { Symbol, colonOp }
@external tokens lessThanTokenizer from "./tokens" {
  Heredoc,
  lessThanOp[@name=CompareOp],
  lessThanEqOp[@name=CompareOp],
  inheritsOp,
  shiftLeftOp
}
@external tokens greaterThanTokenizer from "./tokens" {
  greaterThanOp[@name=CompareOp],
  greaterThanEqOp[@name=CompareOp],
  shiftRightOp
}
@detectDelim
